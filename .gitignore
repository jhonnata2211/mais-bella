node_modules/
.env
.env.*
!.env.example
npm-debug.log*
.DS_Store

# SQLite e arquivos auxiliares: dados locais nunca são versionados.
*.sqlite
*.sqlite-*
*.sqlite3
*.sqlite3-*
*.db
*.db-*

# Fotos recebidas em runtime (inclui temporárias); somente a estrutura é versionada.
/data/uploads/*
!/data/uploads/.gitkeep
