# Node.js 24.15+ com node:sqlite. Este arquivo não contém credenciais.
PORT=3000
DB_PATH=data/maisbella.sqlite
NODE_ENV=development
SEED_DEMO=true
# Origem EXATA usada no navegador (sem barra final); ajuste também a porta.
APP_ORIGIN=http://localhost:3000
# Execute npm run admin:configure para gerar no .env privado:
# ADMIN_USER
# ADMIN_PASSWORD_HASH (scrypt; mantenha entre aspas simples no .env)
# SESSION_SECRET (32 bytes aleatórios em hexadecimal)
# Produção exige NODE_ENV=production, SEED_DEMO=false e APP_ORIGIN=https://...
# Apenas se HTTPS terminar num proxy confiável na mesma máquina:
# TRUST_PROXY=loopback
