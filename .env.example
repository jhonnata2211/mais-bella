# Node.js 24.15+ com node:sqlite. Este arquivo não contém credenciais.
PORT=3000
DB_PATH=data/maisbella.sqlite
# development, test ou production (outros valores são recusados)
NODE_ENV=development
SEED_DEMO=false
# Origem EXATA usada no navegador (sem barra final); ajuste também a porta.
APP_ORIGIN=http://localhost:3000
# Execute npm run admin:configure para gerar no .env privado:
# ADMIN_USER
# ADMIN_PASSWORD_HASH (scrypt; mantenha entre aspas simples no .env)
# SESSION_SECRET (32 bytes aleatórios em hexadecimal)
# Produção exige NODE_ENV=production, SEED_DEMO=false e APP_ORIGIN=https://...
# Apenas se HTTPS terminar num proxy confiável na mesma máquina:
# TRUST_PROXY=loopback
# Railway: TRUST_PROXY=railway (produção, ingresso HTTP exclusivo, SEM TCP Proxy).
# RAILWAY_PROJECT_ID e RAILWAY_SERVICE_ID são fornecidas pela plataforma.
# Não use railway em rede/servidor onde clientes alcançam a porta Node diretamente.
# Fotos de produtos: padrão privado e ignorado pelo Git.
# Para volume persistente no deploy, use caminho absoluto fora do repositório.
# UPLOAD_DIR=data/uploads

# Desenvolvimento com exemplos: habilite SEED_DEMO=true explicitamente.
# Produção nova começa vazia; nunca habilite seed em produção.
# DB_PATH e UPLOAD_DIR aceitam caminhos absolutos em volumes persistentes.
# WhatsApp comercial: único local público em public/js/config.mjs, não é segredo.
# Manutenção somente com servidor parado (não habilite durante operação):
# MAINTENANCE_MODE=true
# BACKUP_DIR=/caminho/externo/backup-novo (diretório pai já existente)

# Backup online: npm run production:backup -- --online (sem MAINTENANCE_MODE).
# BACKUP_ROOT=/data/backups (pasta dedicada existente, fora de uploads/código)
# BACKUP_DIR=/data/backups/maisbella-AAAA-MM-DD-HHMMSS (destino novo)
# Verificação/restauração em diretório novo: BACKUP_DIR + RESTORE_DIR; veja README.
